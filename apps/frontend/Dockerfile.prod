# Produktions-Dockerfile für das Frontend
# Build-Kontext ist das Repo-Root (siehe docker-compose.prod.yml), damit
# das geteilte Paket packages/shared beim Vite-Build verfügbar ist.

FROM node:20-alpine AS builder
WORKDIR /repo

# Geteiltes Paket zuerst (für Layer-Caching)
COPY packages/shared ./packages/shared

# Frontend-Abhängigkeiten
COPY apps/frontend/package*.json ./apps/frontend/
WORKDIR /repo/apps/frontend
RUN npm ci

# Frontend-Quellcode und Build
COPY apps/frontend/ ./
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# --------------------------------------------------------
# Produktions-Image: statisches Ausliefern über nginx
# --------------------------------------------------------
FROM nginx:1.27-alpine
COPY apps/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/apps/frontend/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
