# ============================================================
# SchulAdmin – Umgebungsvariablen (Beispiel)
# NIEMALS echte Werte ins Repository committen!
# ============================================================

# --- Lokal (Docker / npm run dev) ---
DATABASE_URL="mysql://schuladmin:password@localhost:3307/schuladmin"
DB_ROOT_PASSWORD="rootpassword"
DB_USER="schuladmin"
DB_PASSWORD="password"

JWT_SECRET="min-32-zeichen-langer-zufaelliger-string-hier-eintragen"
JWT_REFRESH_SECRET="ein-anderer-min-32-zeichen-string-hier-eintragen"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173"

TOTP_APP_NAME="SchulAdmin"
TOTP_ISSUER="IT Bénédict Zürich"
ABSENCE_THRESHOLD=5
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"
UPLOAD_DIR="./uploads"

# --- Produktion Railway (Backend-Service) ---
# DATABASE_URL=${{MySQL.MYSQL_URL}}
# NODE_ENV=production
# PORT wird von Railway gesetzt
# FRONTEND_URL=https://dein-projekt.vercel.app
# ALLOWED_ORIGINS=https://dein-projekt.vercel.app
# JWT_SECRET=<openssl rand -base64 48>
# JWT_REFRESH_SECRET=<openssl rand -base64 48>
# UPLOAD_DIR=/app/uploads
# (Railway Volume an /app/uploads mounten für persistente Arztzeugnis-Scans)

# --- Produktion Vercel (Frontend) ---
# VITE_API_URL=https://dein-backend.up.railway.app
