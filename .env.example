# ============================================================
# SchulAdmin – Umgebungsvariablen (Beispiel)
# NIEMALS echte Werte ins Repository committen!
# ============================================================

# Datenbank
DATABASE_URL="mysql://schuladmin:password@localhost:3307/schuladmin"
DB_ROOT_PASSWORD="rootpassword"
DB_USER="schuladmin"
DB_PASSWORD="password"

# JWT – mindestens 32 Zeichen, zufällig generiert!
JWT_SECRET="min-32-zeichen-langer-zufaelliger-string-hier-eintragen"
JWT_REFRESH_SECRET="ein-anderer-min-32-zeichen-string-hier-eintragen"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173"

# 2FA
TOTP_APP_NAME="SchulAdmin"
TOTP_ISSUER="IT Bénédict Zürich"

# Absenzen-Schwellenwert (Standard: 5 unentschuldigte Absenzen)
ABSENCE_THRESHOLD=5

# Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"
